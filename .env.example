# ==========================================
# EduLink Platform — Environment Configuration
# ==========================================

COMPOSE_PROJECT_NAME=edulink

# Django Core
DEBUG=True
SECRET_KEY=edulink-insecure-dev-key-change-in-production-2026-ao
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,*.edu.ao,*.localhost

# Base de Dados (PostgreSQL 16)
POSTGRES_DB=edulink
POSTGRES_USER=edulink_admin
POSTGRES_PASSWORD=dev_password_123
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://edulink_admin:dev_password_123@db:5432/edulink

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Segurança e Criptografia
# Chave Fernet (AES-256) para credenciais Google/Microsoft (Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
EDULINK_FERNET_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS1mb3ItZGV2IQ==
EDULINK_JWT_SECRET=edulink-passport-jwt-secret-signature-2026

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://admin.localhost:3000,http://portal.localhost:3000

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Cloudflare DNS & Domínios .edu.ao (Opcional em dev -> usa modo Sandbox)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
EDULINK_WEB_TARGET=sites.edulink.ao

# Caddy On-Demand TLS & Keycloak SSO (OIDC / SAML 2.0 Canva)
ACME_EMAIL=infra@edulink.ao
EDULINK_PLATFORM_DOMAINS=edulink.ao,www.edulink.ao,admin.edulink.ao,portal.edulink.ao,sso.edulink.ao,api.edulink.ao
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=edulink
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=edulink_kc_admin_2026

# Bootstrap Inicial da Plataforma (python manage.py bootstrap_edulink)
EDULINK_ADMIN_EMAIL=admin@edulink.ao
EDULINK_ADMIN_PASSWORD=
EDULINK_ADMIN_NAME=Operador EduLink

# E-mail Transacional (SMTP em Produção; vazio = console em Dev)
EDULINK_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=EduLink Angola <no-reply@edulink.ao>
